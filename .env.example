# Copie este arquivo para .env e preencha os valores.
# O .env nunca deve ser versionado.

# Chave do Google AI Studio
GOOGLE_API_KEY=
# Usar a API do AI Studio (e nao Vertex AI): FALSE
GOOGLE_GENAI_USE_VERTEXAI=

# Modelos Gemini (um para o agente principal, outro para os especialistas)
MODELO_PRINCIPAL=
MODELO_ESPECIALISTAS=

# Banco PostgreSQL (se vazio, valem os padroes do docker-compose.yml)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Ambiente: "producao" bloqueia o comando de restauracao dos dados
AMBIENTE=
